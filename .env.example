# LifeStory environment variables. Names only: fill in your own values in
# .env.local (never commit real values). See docs/SETUP.md for what each does.

# Database: leave DATABASE_URL empty locally and set DATABASE_DRIVER=pglite.
DATABASE_URL=
DATABASE_DRIVER=
PGLITE_DATA_DIR=

# Auth: BETTER_AUTH_SECRET is required (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# AI: AI_PROVIDER is anthropic, fixture or none.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Global ceiling on AI calls per UTC day, across all accounts. Unset or not a
# whole number: 500. 0 pauses AI. There is no "unlimited" value.
AI_GLOBAL_DAILY_LIMIT=

# Transcription: TRANSCRIPTION_PROVIDER is openai, deepgram or none.
TRANSCRIPTION_PROVIDER=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=

# Storage: STORAGE_PROVIDER is vercel-blob or local.
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Jobs cron
CRON_SECRET=

# Operational limits
MAX_UPLOAD_MB=
MAX_RECORDING_SECONDS=
DEFAULT_AUDIO_RETENTION_DAYS=

# Conversation Weave (off unless WEAVE_ENABLED is 1 or true)
WEAVE_ENABLED=
WEAVE_BLOB_READ_WRITE_TOKEN=
WEAVE_BLOB_STORE_ID=
WEAVE_BLOB_WEBHOOK_PUBLIC_KEY=
MAX_WEAVE_UPLOAD_MB=
MAX_WEAVE_RECORDINGS=
